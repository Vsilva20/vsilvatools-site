---
import ProductCard from './ProductCard.astro';
import { getFeaturedProducts } from '../data/products';

const featuredProducts = getFeaturedProducts(6);
const slides = Array.from({ length: Math.ceil(featuredProducts.length / 3) }, (_, index) => featuredProducts.slice(index * 3, index * 3 + 3));
---

<div class="container my-5">
  <h2 class="text-center mb-5 fw-bold">Promoções em Destaque</h2>

  <div id="carouselProdutos" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner px-2">
      {slides.map((products, index) => (
        <div class:list={['carousel-item', { active: index === 0 }]}>
          <div class="row justify-content-center">
            {products.map((product) => (
              <div class="col-md-4 col-sm-6 mb-4">
                <ProductCard product={product} variant="featured" />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <button
      class="btn btn-dark position-absolute top-50 start-0 translate-middle-y rounded-circle shadow featured-carousel-control featured-carousel-control-prev"
      data-bs-target="#carouselProdutos"
      data-bs-slide="prev"
      aria-label="Produtos anteriores"
    >
      <i class="bi bi-chevron-left fs-5" aria-hidden="true"></i>
    </button>
    <button
      class="btn btn-dark position-absolute top-50 end-0 translate-middle-y rounded-circle shadow featured-carousel-control featured-carousel-control-next"
      data-bs-target="#carouselProdutos"
      data-bs-slide="next"
      aria-label="Próximos produtos"
    >
      <i class="bi bi-chevron-right fs-5" aria-hidden="true"></i>
    </button>
  </div>
</div>
