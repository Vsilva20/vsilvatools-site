---
interface Props {
  productId: number;
  productName: string;
  images: string[];
}

const { productId, productName, images } = Astro.props;
const carouselId = `carouselProduto-${productId}`;
---

<div id={carouselId} class="carousel slide shadow-sm" data-bs-ride="carousel">
  <div class="carousel-inner product-gallery-inner">
    {images.map((image, index) => (
      <div class:list={['carousel-item', { active: index === 0 }]}>
        <div class="d-flex justify-content-center bg-white p-3 rounded product-gallery-frame">
          <img src={`/assets/img/produtos/${image}`} class="img-fluid product-gallery-image" alt={`${productName}${index ? ` - imagem ${index + 1}` : ''}`} />
        </div>
      </div>
    ))}
  </div>

  {images.length > 1 && (
    <>
      <button
        class="btn btn-success position-absolute top-50 start-0 translate-middle-y ms-2 rounded-circle shadow product-gallery-control"
        data-bs-target={`#${carouselId}`}
        data-bs-slide="prev"
        aria-label="Imagem anterior"
      >
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
      </button>
      <button
        class="btn btn-success position-absolute top-50 end-0 translate-middle-y me-2 rounded-circle shadow product-gallery-control"
        data-bs-target={`#${carouselId}`}
        data-bs-slide="next"
        aria-label="Próxima imagem"
      >
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </button>
    </>
  )}
</div>
