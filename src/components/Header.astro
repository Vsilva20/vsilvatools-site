---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/produtos', label: 'Produtos' },
  { href: '/contato', label: 'Contato' },
];

function isActive(href: string): boolean {
  return href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="/">
      <img src="/assets/img/logo.png" alt="Vsilva Tools" height="60" width="auto" style="object-fit: contain;" />
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Alternar navegação"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto" id="nav-links">
        {links.map((link) => (
          <li class="nav-item">
            <a class:list={['nav-link', { active: isActive(link.href) }]} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="nav-item ms-lg-2">
          <a
            class:list={['nav-link quote-cart-link d-inline-flex align-items-center gap-2', { active: currentPath === '/carrinho' }]}
            href="/carrinho"
            aria-label="Abrir meu orçamento: 0 itens"
            aria-current={currentPath === '/carrinho' ? 'page' : undefined}
          >
            <i class="bi bi-cart3" aria-hidden="true"></i>
            <span class="quote-cart-label">Meu Orçamento</span>
            <span class="badge rounded-pill quote-cart-badge" data-quote-cart-badge aria-hidden="true">0</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>
