---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página Não Encontrada - Vsilva Tools"
  description="A página solicitada não foi encontrada."
  robots="noindex,nofollow"
  bodyClass="d-flex flex-column min-vh-100 bg-dark text-white text-center"
>
  <main class="container d-flex flex-column justify-content-center align-items-center flex-grow-1 py-5">
    <div class="mb-4"><i class="bi bi-exclamation-triangle error-icon" aria-hidden="true"></i></div>
    <h1 class="display-1 fw-bold mb-3 text-brand-green">404</h1>
    <h2 class="fw-bold mb-4">Página Não Encontrada</h2>
    <p class="fs-5 text-muted mb-5 mx-auto error-copy">Desculpe, a página que você está procurando não existe, foi removida ou o endereço foi digitado incorretamente.</p>
    <div class="d-flex gap-3 flex-wrap justify-content-center">
      <a href="/" class="btn btn-success btn-lg px-4 rounded-pill"><i class="bi bi-house-door me-2" aria-hidden="true"></i>Ir para a Home</a>
      <a href="/produtos" class="btn btn-outline-success btn-lg px-4 rounded-pill"><i class="bi bi-tools me-2" aria-hidden="true"></i>Ver Produtos</a>
    </div>
  </main>
</BaseLayout>
