---
export const prerender = false;

import { getProductById } from '../data/products';

const rawId = Astro.url.searchParams.get('id') ?? '';
const id = /^\d+$/.test(rawId) ? Number(rawId) : 0;
const legacyProduct = getProductById(id);
if (!legacyProduct) {
  return Astro.redirect('/404', 301);
}
return Astro.redirect(`/produtos/${legacyProduct.slug}`, 301);
---
